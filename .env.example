# ============================================================
#  環境変数テンプレート
#  このファイルをコピーして `.env` を作成し、値を設定してください:
#      cp .env.example .env
#  ※ `.env` は .gitignore で除外されています（コミットされません）
# ============================================================

# --- J-Quants API (https://jpx-jquants.com/) ---
# APIキー（推奨）またはメールアドレス＋パスワードのいずれかを設定
JQUANTS_API_KEY=
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=

# --- FRED API (https://fred.stlouisfed.org/docs/api/api_key.html) ---
# 米国金利・マクロ指標の取得に使用（任意。未設定時は FRED 系列をスキップ）
FRED_API_KEY=

# --- kabuステーション API ---
# kabuステーションの「API設定」で指定したパスワード
KABU_API_PASSWORD=
# 注文用暗証番号（発注時に使用）
KABU_TRADING_PASSWORD=
# 接続ホスト / ポート（0 の場合は 18080/18081 を自動探索）
KABU_HOST=127.0.0.1
KABU_PORT=0

# --- Kaggle (GPU 学習用カーネルの公開/取得に使用) ---
KAGGLE_USERNAME=
KAGGLE_DATASET_SLUG=

# --- Slack 通知 (任意) ---
SLACK_WEBHOOK_URL=
