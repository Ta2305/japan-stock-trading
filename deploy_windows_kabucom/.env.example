# ============================================================
#  deploy_windows_kabucom 用 環境変数テンプレート
#  このファイルをコピーして `.env` を作成し、値を設定してください:
#      cp .env.example .env
#  ※ `.env` は .gitignore で除外されています（コミットされません）
# ============================================================

# kabuステーション の「API設定」で指定したパスワード
KABU_API_PASSWORD=
# 注文用暗証番号
KABU_TRADING_PASSWORD=
# ホスト / ポート（18081: 検証用, 18080: 本番）
KABU_HOST=127.0.0.1
KABU_PORT=18081
